<!-- Admin -->
<div class="page" id="page-admin">
    <div class="standard-button">
        <button class="zurück" data-page="start">Zurück</button>
    </div>
    <h2>Admin - NPK-Materialien</h2>

    <div id="admin-npk-liste" style="max-width:600px;margin:20px auto;"></div>

    <div style="min-width:300px;margin:20px auto;">
        <h3 style="text-align:center;">Neues Material</h3>
        <div style="display:flex;flex-direction:column;gap:8px;">
            <input id="adm-key" placeholder="Key (z.B. kokos)">
            <input id="adm-name" placeholder="Name">
            <input id="adm-bild" placeholder="Bild-Dateiname (z.B. kokos.jpg)">
            <div style="display:flex;gap:8px;">
                <input id="adm-n" type="number" step="0.01" placeholder="N %">
                <input id="adm-p" type="number" step="0.01" placeholder="P %">
            </div>
            <div style="display:flex;gap:8px;">
                <input id="adm-k" type="number" step="0.01" placeholder="K %">
                <input id="adm-ca" type="number" step="0.01" placeholder="Ca %">
            </div>
            <div style="display:flex;gap:8px;"></div>
                <input id="adm-mg" type="number" step="0.01" placeholder="Mg %">
                <input id="adm-s" type="number" step="0.01" placeholder="S %">
            </div>
            <button id="adm-speichern" style="padding:8px 16px;background:#3a5a3a;color:#fff;
            border:none;border-radius:4px;cursor:pointer;">Speichern</button>
        </div>
    </div>
</div>  


        <!--Login-->
<div class="page" id="page-login">
    <h2>Login</h2>
    <div class="login-position">
        <div class="login-position-abstand">
            <label>E-Mail:</label>
            <input type="email" id="login-email" placeholder="deine@email.com">
        </div>
        <div class="login-position-abstand">
            <label>Passwort:</label>
            <input type="password" id="login-password" placeholder="••••••••">
        </div>
        <div class="login-position-abstand">
            <button id="login-btn">Anmelden</button>
            <button id="to-register">Registrieren</button>  <!-- ← neu -->
        </div>
    </div>
    <p id="login-msg"></p>
</div>

<!--Registrierung-->
<div class="page" id="page-registrierung" style="display: none;">
    <h2>Registrierung</h2>
    <div class="regist-position">
        <div class="regist-position-abstand">
            <label>Name:</label>
            <input type="text" id="reg-name" placeholder="Dein Name">
        </div>
        <div class="regist-position-abstand">
            <label>E-Mail:</label>
            <input type="email" id="reg-email" placeholder="deine@email.com">
        </div>
        <div class="regist-position-abstand">
            <label>Passwort:</label>
            <input type="password" id="reg-password" placeholder="••••••••"
                minlength="8" 
                pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{8,}$" 
                required>
        </div>
        <div class="regist-position-abstand">
            <button id="register-btn">Registrieren</button>
            <button id="to-login">Zurück</button>
        </div>
    </div>
    <p id="register-msg"></p>  
</div>   

<!-- Volumen -->
<div class="page" id="page-volumen">
    <div class="standard-button">
        <button class="zurück" data-page="start">Zurück</button>
        <button class="t-buch" data-page="tagebuch">Tagebuch</button>
    </div>
    <h2 class="v-über">Volumen-Rechner</h2>
    <div class="v-all">
        <div class="volumen-rechner">
            <div class="x">Länge: <input type="number" class="eingabe-volumen" min="0"></div>
        </div>
        <div class="volumen-rechner">
            <div class="x">Breite: <input type="number" class="eingabe-volumen" min="0"></div>
        </div>
        <div class="volumen-rechner">
            <div class="x">Höhe: <input type="number" class="eingabe-volumen-2" min="0"></div>
        </div>
    </div>
    <div class="wert">
        <select id="einheit">
            <option value="mm">mm</option>
            <option value="cm" selected>cm</option>
            <option value="dm">dm</option>
            <option value="m">m</option>
        </select>
        <button id="volumen-berechnen"></button>
    </div>
</div>

<!-- Rasen -->
<div class="page" id="page-rasen">
    <div class="standard-button">
        <button class="zurück" data-page="start">Zurück</button>
        <button class="t-buch" data-page="tagebuch">Tagebuch</button>
    </div>
    <h2>Rasenerde-Rechner</h2>
</div>

<!-- Quiz -->
<div class="page" id="page-quiz">
    <div class="standard-button">
        <button class="zurück" data-page="start">Zurück</button>
        <button class="t-buch" data-page="tagebuch">Tagebuch</button>
    </div>
    <h2>Quiz</h2>
</div>

<!-- Tagebuch -->
<div class="page" id="page-tagebuch">
    <div class="standard-button">
        <button class="zurück" data-page="start">Zurück</button>
    </div>
    <h2>Tagebuch</h2>

    <div class="tagebuch-formular">
        <input type="text" id="tb-titel" placeholder="Titel">
        <textarea id="tb-text" placeholder="Was ist heute im Garten passiert?" rows="3"></textarea>
        <button id="tb-speichern">Speichern</button>
    </div>

    <div id="tagebuch-liste"></div>
</div>   
