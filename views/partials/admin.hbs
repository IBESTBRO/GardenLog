<!-- Admin -->
<div class="page" id="page-admin">
    <div class="standard-button">
        <button class="zurück" data-page="start">Zurück🛖</button>
    </div>
    <h2>Admin - NPK-Materialien</h2>

    <div id="admin-npk-liste" style="max-width:600px;margin:20px auto;"></div>

    <div style="min-width:300px;margin:20px auto;">
        <h3 style="text-align:center;">Neues Material</h3>
        <div style="display:flex;flex-direction:column;gap:8px;">
            <input id="adm-key" placeholder="Key (z.B. kokos)">
            <input id="adm-name" placeholder="Name">
            <input type="file" id="adm-bild-file" accept="image/*" style="background:#fff;padding:6px;border:1px solid #999;border-radius:4px;">
            <div style="display:flex;gap:8px;">
                <input id="adm-n" type="number" step="0.01" placeholder="N %">
                <input id="adm-p" type="number" step="0.01" placeholder="P %">
            </div>
            <div style="display:flex;gap:8px;">
                <input id="adm-k" type="number" step="0.01" placeholder="K %">
                <input id="adm-ca" type="number" step="0.01" placeholder="Ca %">
            </div>
            <div style="display:flex;gap:8px;"></div>
                <input id="adm-mg" type="number" step="0.01" placeholder="Mg %">
                <input id="adm-s" type="number" step="0.01" placeholder="S %">
            </div>
            <button id="adm-speichern" style="padding:8px 16px;background:#3a5a3a;color:#fff;
            border:none;border-radius:4px;cursor:pointer;">Speichern💾</button>
        </div>
    </div>
</div>  